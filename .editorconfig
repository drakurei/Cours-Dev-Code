# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown : deux espaces en fin de ligne = retour à la ligne, on les garde.
[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 lit un script sans BOM en ANSI : le BOM garde les accents intacts.
[*.ps1]
charset = utf-8-bom
