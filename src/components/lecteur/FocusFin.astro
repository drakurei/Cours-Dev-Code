---
/**
 * Dernière étape du Mode Focus : tampon 済, « J'ai compris ce cours », puis « Épisode suivant ».
 * Rendue dans l'article mais affichée seulement en Focus (html[data-focus] + data-focus-courante).
 * Le bouton et le tampon réutilisent progression.ts (data-action="terminer", data-hanko-cours,
 * data-statut-cours) : rien à brancher en plus.
 */
import Hanko from '../Hanko.astro';
import Icone from '../Icone.astro';
import EpisodeSuivant from './EpisodeSuivant.astro';
import type { CoursVue } from '../../lib/cours.ts';
import type { MatiereVue } from '../../lib/matieres.ts';

interface Props {
  coursId: string;
  suivant: CoursVue | null;
  matiere: MatiereVue;
}

const { coursId, suivant, matiere } = Astro.props;
---

<section id="lecteur-fin" class="focus-fin" aria-labelledby="lecteur-fin-titre" data-statut-cours={coursId} data-statut="a-lire">
  <div class="focus-fin__tampon">
    <Hanko taille={104} coursId={coursId} lignes />
    <span class="focus-fin__vide" lang="ja" aria-hidden="true">済</span>
  </div>
  <p class="focus-fin__sur-titre">Dernière étape</p>
  <h2 class="focus-fin__titre" id="lecteur-fin-titre">Fin du cours</h2>
  <p class="focus-fin__texte focus-fin__texte--avant">Tu as tout vu. Tamponne le cours pour ranger ses cartes dans tes révisions.</p>
  <p class="focus-fin__texte focus-fin__texte--apres">Cours tamponné. Ses cartes rejoignent tes révisions.</p>
  <button class="btn btn--primaire btn--grand focus-fin__bouton" type="button" data-action="terminer" data-cours-id={coursId} aria-pressed="false">
    <Icone nom="coche" taille={20} />
    <span data-libelle>J’ai compris ce cours</span>
  </button>
  <EpisodeSuivant suivant={suivant} matiere={matiere} continuer />
</section>

<style>
  .focus-fin {
    display: none;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  :global(html[data-focus]) .focus-fin[data-focus-courante] { display: grid; }

  .focus-fin__tampon {
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    margin-bottom: var(--s-2);
  }

  .focus-fin__tampon > :global(*) { grid-area: 1 / 1; }

  /* Emplacement du tampon, en pointillé tant que le cours n'est pas fini. */
  .focus-fin__vide {
    display: grid;
    place-items: center;
    width: 90px;
    height: 90px;
    border-radius: 18px;
    box-shadow: inset 0 0 0 2px var(--c-line-strong);
    color: var(--c-line-strong);
    font: 700 3rem/1 var(--font-kanji);
    rotate: -8deg;
    /* Pointillé d'encre (masque alpha, pas une couleur affichée). */
    mask-image: repeating-linear-gradient(45deg, #000 0 6px, rgb(0 0 0 / 0.55) 6px 9px);
  }

  .focus-fin__tampon:has(:global(.hanko:not([hidden]))) .focus-fin__vide { display: none; }

  .focus-fin__sur-titre {
    color: var(--c-ink-3);
    font: 600 0.8125rem/1.4 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .focus-fin__titre {
    margin-top: calc(-1 * var(--s-3));
    font: 700 clamp(1.75rem, 1.1rem + 2.2vw, 2.5rem) / 1.15 var(--font-ui);
    letter-spacing: -0.025em;
  }

  .focus-fin__texte { max-width: 34ch; color: var(--c-ink-2); font: var(--t-read); font-size: 1.1875rem; }
  .focus-fin__texte--apres,
  .focus-fin[data-statut="termine"] .focus-fin__texte--avant { display: none; }
  .focus-fin[data-statut="termine"] .focus-fin__texte--apres { display: block; }

  .focus-fin__bouton { margin-block: var(--s-2) var(--s-3); }

  .focus-fin__bouton[data-termine="true"] {
    --btn-bg: var(--c-accent-soft);
    --btn-ink: var(--c-accent-ink);
    box-shadow: none;
  }
</style>
