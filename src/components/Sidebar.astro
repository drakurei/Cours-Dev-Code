---
/**
 * Barre latérale (≥ 1024 px), matériau verre façon app macOS :
 * logo, recherche (⌘K / Ctrl K), 7 entrées avec kanji, badge « à réviser », minuteur en bas.
 * Le badge [data-badge="a-reviser"] et les compteurs sont remplis par src/scripts/progression.ts.
 */
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import Minuteur from '../islands/Minuteur.tsx';
import { KANJI_NAVIGATION, type PageNav } from '../lib/kanji.ts';
import { url } from '../lib/url.ts';

interface Props {
  pageActive?: PageNav | null | undefined;
}

const { pageActive = null } = Astro.props;

const groupes: { titre: string; pages: PageNav[] }[] = [
  { titre: 'Apprendre', pages: ['aujourdhui', 'tomes', 'reviser', 'projets', 'glossaire'] },
  { titre: 'Outils', pages: ['atelier', 'reglages'] },
];
---

<aside class="sidebar verre" aria-label="Navigation principale">
  <a class="sidebar__logo" href={url('/')} aria-label="Manabi, retour à Aujourd’hui">
    <Logo />
  </a>

  <button class="sidebar__recherche" type="button" data-action="recherche" aria-keyshortcuts="Control+K Meta+K /">
    <Icone nom="recherche" taille={17} />
    <span>Rechercher</span>
    <kbd class="sidebar__raccourci" data-raccourci>Ctrl K</kbd>
  </button>

  <nav class="sidebar__nav" aria-label="Sections du site">
    {
      groupes.map((g) => (
        <div class="sidebar__groupe">
          <p class="sidebar__titre-groupe">{g.titre}</p>
          <ul role="list">
            {g.pages.map((cle) => {
              const p = KANJI_NAVIGATION[cle];
              const actif = cle === pageActive;
              return (
                <li>
                  <a class="sidebar__lien" href={url(p.chemin)} aria-current={actif ? 'page' : undefined}>
                    <span class="sidebar__kanji" lang="ja" aria-hidden="true" title={p.lecture}>{p.kanji}</span>
                    <span class="sidebar__libelle">{p.libelle}</span>
                    {cle === 'reviser' && <span class="sidebar__badge" data-badge="a-reviser" hidden>0</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="sidebar__pied">
    <Minuteur client:idle />
    <p class="sidebar__stats">
      <span title="Série de jours"><span lang="ja" aria-hidden="true">連</span> <span data-compteur="serie">0</span><span class="sr-only"> jours de suite</span></span>
      <span title="Pétales gagnés"><span lang="ja" aria-hidden="true">花びら</span> <span data-compteur="petales">0</span><span class="sr-only"> pétales</span></span>
    </p>
  </div>
</aside>

<script>
  // ⌘K sur Mac / iPad, Ctrl K ailleurs.
  const mac = /Mac|iPhone|iPad/.test(navigator.platform) || navigator.userAgent.includes('Mac OS');
  if (mac) for (const k of document.querySelectorAll('[data-raccourci]')) k.textContent = '⌘ K';
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    width: var(--sidebar-w);
    height: 100dvh;
    padding: var(--s-5) var(--s-3) var(--s-4);
    padding-left: calc(var(--s-3) + var(--safe-left));
    border-right: 1px solid var(--c-line);
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 20;
  }

  .sidebar__logo {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-sm);
    text-decoration: none;
  }

  .sidebar__recherche {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    margin: 0 var(--s-1);
    padding: 0 var(--s-2) 0 var(--s-3);
    border: 0;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--c-ink) 6%, transparent);
    color: var(--c-ink-3);
    font: var(--t-subhead);
    text-align: left;
    transition: background-color var(--d-1) var(--ease-out);
  }

  .sidebar__recherche:hover { background: color-mix(in srgb, var(--c-ink) 9%, transparent); }
  .sidebar__recherche span { flex: 1; }
  .sidebar__raccourci { font-size: 0.6875rem; }

  .sidebar__nav { display: grid; gap: var(--s-4); }

  .sidebar__titre-groupe {
    padding: 0 var(--s-3) var(--s-1);
    color: var(--c-ink-3);
    font: 600 0.6875rem/1.3 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sidebar__nav ul { display: grid; gap: 2px; margin: 0; }

  .sidebar__lien {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--cible);
    padding: 0 var(--s-3);
    border-radius: var(--r-sm);
    color: var(--c-ink);
    font: 500 0.9375rem/1.2 var(--font-ui);
    text-decoration: none;
    transition: background-color var(--d-1) var(--ease-out), color var(--d-1) var(--ease-out);
  }

  .sidebar__lien:hover { background: color-mix(in srgb, var(--c-ink) 6%, transparent); color: var(--c-ink); }

  .sidebar__kanji {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--c-ink) 6%, transparent);
    color: var(--c-ink-2);
    font: 700 0.9375rem/1 var(--font-kanji);
    transition: background-color var(--d-2) var(--ease-out), color var(--d-2) var(--ease-out);
  }

  .sidebar__lien[aria-current="page"] {
    background: var(--c-accent-soft);
    color: var(--c-accent-ink);
    font-weight: 600;
  }

  .sidebar__lien[aria-current="page"] .sidebar__kanji {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .sidebar__libelle { flex: 1; }

  .sidebar__badge {
    min-width: 22px;
    height: 22px;
    padding: 0 7px;
    border-radius: var(--r-full);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font: 600 0.75rem/22px var(--font-ui);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .sidebar__pied {
    display: grid;
    gap: var(--s-3);
    margin-top: auto;
    padding: var(--s-3) var(--s-1) 0;
    border-top: 1px solid var(--c-line);
  }

  .sidebar__stats {
    display: flex;
    justify-content: space-between;
    padding: 0 var(--s-2);
    color: var(--c-ink-3);
    font: 500 0.8125rem/1.2 var(--font-ui);
    font-variant-numeric: tabular-nums;
  }

  .sidebar__stats [lang="ja"] { color: var(--c-ink-2); }

  @media (max-width: 1023px) {
    .sidebar { display: none; }
  }
</style>
