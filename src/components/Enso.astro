---
/**
 * Ensō 円相 : cercle au pinceau qui se remplit = progression (0..1).
 * Mis à jour côté client par src/scripts/progression.ts :
 *   coursId  → data-enso-cours (+ data-enso-sections = nombre de notions)
 *   ids      → data-enso-ids (part des cours terminés)
 */
import { idUnique } from '../lib/ids.ts';

interface Props {
  valeur?: number;
  taille?: number;
  /** Un cours : son id et son nombre de notions (##). */
  coursId?: string | undefined;
  sections?: number | undefined;
  /** Un ensemble de cours (tome, accueil). */
  ids?: string[] | undefined;
  /** Texte lu par les lecteurs d'écran (« Progression du cours »). */
  libelle?: string;
  /** Affiche « 40 % » au centre. */
  afficherValeur?: boolean;
  /** Texture d'encre (désactivée d'office sous 40 px). */
  encre?: boolean;
  class?: string;
}

const {
  valeur = 0,
  taille = 56,
  coursId,
  sections,
  ids,
  libelle = 'Progression',
  afficherValeur = false,
  encre = true,
  class: classe,
} = Astro.props;

const v = Math.min(1, Math.max(0, valeur));
const pourcent = Math.round(v * 100);
const avecEncre = encre && taille >= 40;
const idFiltre = idUnique('enso-encre');
// Trait ouvert, légèrement irrégulier, qui laisse une petite ouverture en haut à droite.
const TRAIT = 'M64 13C42 5 13 18 10.5 46C8 74 30 92.5 54 90.5C78 88.5 92 69 89.5 46C88 31 79.5 21 70.5 16.5';
---

<span
  class:list={['enso', classe]}
  role="img"
  aria-label={`${libelle} : ${pourcent} %`}
  data-enso-libelle={libelle}
  data-enso-cours={coursId}
  data-enso-sections={coursId ? String(sections ?? 0) : undefined}
  data-enso-ids={ids?.join(' ')}
  data-valeur={pourcent}
  style={`--valeur: ${v}; --taille: ${taille}px`}
>
  <svg viewBox="0 0 100 100" width={taille} height={taille} aria-hidden="true" focusable="false">
    {
      avecEncre && (
        <filter id={idFiltre} x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="bruit" />
          <feDisplacementMap in="SourceGraphic" in2="bruit" scale="2.2" />
        </filter>
      )
    }
    <path class="enso__fond" d={TRAIT} pathLength="100" />
    <path class="enso__trait" d={TRAIT} pathLength="100" filter={avecEncre ? `url(#${idFiltre})` : undefined} />
  </svg>
  {afficherValeur && <span class="enso__texte" data-enso-texte aria-hidden="true">{pourcent} %</span>}
</span>

<style>
  .enso {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--taille);
    height: var(--taille);
  }

  .enso svg { overflow: visible; }

  .enso path {
    fill: none;
    stroke-linecap: round;
    stroke-width: 7;
  }

  .enso__fond { stroke: var(--c-line); }

  .enso__trait {
    stroke: var(--enso-encre, var(--c-ink));
    stroke-dasharray: 100 100;
    stroke-dashoffset: calc(100 - var(--valeur) * 100);
    transition: stroke-dashoffset var(--d-4) var(--ease-out);
  }

  /* Rien de lu : pas de point d'encre parasite. */
  .enso[data-valeur="0"] .enso__trait { opacity: 0; }

  /* Terminé : l'encre passe au vermillon du hanko. */
  .enso[data-valeur="100"] { --enso-encre: var(--c-hanko); }

  .enso__texte {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--c-ink-2);
    font: 600 calc(var(--taille) * 0.2) / 1 var(--font-ui);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
</style>
