---
/**
 * /tomes/<matiere>/ — couverture, description, progression et liste des épisodes.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TomeCouverture from '../../components/TomeCouverture.astro';
import ChapitreLigne from '../../components/ChapitreLigne.astro';
import Enso from '../../components/Enso.astro';
import EtatVide from '../../components/EtatVide.astro';
import Icone from '../../components/Icone.astro';
import { sectionsDuCours, tomesPublies, type Tome } from '../../lib/cours.ts';
import { pluriel } from '../../lib/texte.ts';
import { url } from '../../lib/url.ts';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const tomes = await tomesPublies();
  return tomes.map((tome) => ({ params: { matiere: tome.matiere.slug }, props: { tome } }));
}

interface Props {
  tome: Tome<CollectionEntry<'cours'>>;
}

const { tome } = Astro.props;
const { matiere, cours } = tome;
const ids = cours.map((c) => c.id);
// Nombre de notions (##) par épisode, pour le petit ensō « en cours ».
const notions = await Promise.all(cours.map(async (c) => sectionsDuCours((await render(c.entree)).headings).length));
const premier = cours[0];
---

<BaseLayout titre={matiere.nom} description={matiere.description || `Tome ${matiere.nom} : tous les épisodes.`} pageActive="tomes">
  <nav class="retour" aria-label="Fil d’Ariane">
    <a href={url('/tomes/')}><Icone nom="chevron-gauche" taille={16} />Tomes</a>
  </nav>

  <header class="tome-tete" data-couleur={matiere.couleur}>
    <TomeCouverture matiere={matiere} ids={ids} href={null} taille="grande" />
    <div class="tome-tete__texte">
      <p class="tome-tete__numero">
        <span lang="ja" aria-hidden="true">巻</span>
        {matiere.ordre < 999 ? `Tome ${matiere.ordre}` : 'Tome'}
        {matiere.lecture && <span class="tome-tete__lecture">· {matiere.lecture}</span>}
      </p>
      <h1 class="tome-tete__titre" data-grand-titre>{matiere.nom}</h1>
      {matiere.description && <p class="tome-tete__description">{matiere.description}</p>}
      <div class="tome-tete__progression">
        <Enso taille={56} ids={ids} libelle={`Progression du tome ${matiere.nom}`} afficherValeur />
        <p class="tome-tete__stats">{pluriel(cours.length, 'épisode')} · {tome.duree} min au total</p>
      </div>
      {
        premier && (
          <div class="rangee">
            <a class="btn btn--primaire btn--grand" href={premier.url} data-commencer-tome={matiere.slug}>
              Commencer le <span lang="ja">第{premier.chapitre}話</span>
            </a>
          </div>
        )
      }
    </div>
  </header>

  <section class="episodes" aria-labelledby="episodes-titre">
    <h2 class="episodes__titre" id="episodes-titre">Épisodes</h2>
    {
      cours.length ? (
        <ol class="episodes__liste" role="list">
          {cours.map((c, i) => <ChapitreLigne cours={c} sections={notions[i] ?? 0} />)}
        </ol>
      ) : (
        <EtatVide kanji={matiere.kanji} titre="Ce tome est encore vide" texte="Ajoute un premier épisode depuis l’Atelier ou avec le prompt universel.">
          <a class="btn btn--secondaire" href={url('/atelier/')}>Ouvrir l’Atelier</a>
        </EtatVide>
      )
    }
  </section>
</BaseLayout>

<script>
  // « Commencer » devient « Continuer » vers le premier épisode non terminé.
  import { lire } from '../../lib/store.ts';

  const bouton = document.querySelector<HTMLAnchorElement>('[data-commencer-tome]');
  const lignes = [...document.querySelectorAll<HTMLAnchorElement>('a[data-chapitre]')];
  if (bouton && lignes.length) {
    const etat = lire();
    const commence = lignes.some((l) => etat.progression[l.dataset.chapitre ?? '']);
    const prochain = lignes.find((l) => !etat.progression[l.dataset.chapitre ?? '']?.termine);
    if (commence && prochain) {
      bouton.href = prochain.href;
      bouton.textContent = `Continuer : ${prochain.querySelector('.chapitre__wa')?.textContent ?? ''}`;
    } else if (commence) {
      bouton.textContent = 'Tome terminé : relire le 1er épisode';
    }
  }
</script>

<style>
  .retour a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-height: var(--cible);
    margin-left: calc(-1 * var(--s-2));
    padding: 0 var(--s-2);
    border-radius: var(--r-sm);
    color: var(--c-accent);
    font: 500 0.9375rem/1 var(--font-ui);
    text-decoration: none;
  }

  .tome-tete {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: var(--s-7);
    margin: var(--s-4) 0 var(--s-8);
  }

  .tome-tete__texte { display: grid; gap: var(--s-3); align-content: end; }

  .tome-tete__numero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    color: var(--couleur-ink);
    font: 600 0.875rem/1.3 var(--font-ui);
  }

  .tome-tete__numero [lang="ja"] { font: 700 1rem/1 var(--font-kanji); }
  .tome-tete__lecture { color: var(--c-ink-3); font-weight: 500; }

  .tome-tete__titre {
    font: var(--t-large);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    letter-spacing: var(--t-large-track);
  }

  .tome-tete__description { max-width: 52ch; color: var(--c-ink-2); font: var(--t-body); }
  .tome-tete__progression { display: flex; align-items: center; gap: var(--s-3); margin: var(--s-2) 0; }
  .tome-tete__stats { color: var(--c-ink-3); font: var(--t-subhead); }

  .episodes__titre { margin-bottom: var(--s-3); font: var(--t-title2); letter-spacing: var(--t-title2-track); }

  .episodes__liste {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: var(--s-2);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--sh-1), inset 0 0 0 1px var(--c-line);
  }

  @media (max-width: 767px) {
    .tome-tete { grid-template-columns: 1fr; gap: var(--s-5); justify-items: start; }
    .tome-tete :global(.tome) { --largeur: 148px; }
  }
</style>
